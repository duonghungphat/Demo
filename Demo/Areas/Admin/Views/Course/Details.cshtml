@model Demo.ViewModels.CourseViewModel

<h2>@Model.Title</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!string.IsNullOrEmpty(Model.ImagePath))
{
    <img src="@Model.ImagePath"
         style="max-width:300px"
         class="mb-3" />
}

<dl class="row">
    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">
        @Model.CourseCategoryName
    </dd>

    <dt class="col-sm-3">Instructor</dt>
    <dd class="col-sm-9">
        @Model.InstructorName
    </dd>

    <dt class="col-sm-3">Level</dt>
    <dd class="col-sm-9">@Model.Level</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price</dd>

    <dt class="col-sm-3">DiscountPercent</dt>
    <dd class="col-sm-9">@Model.DiscountPercent</dd>

    <dt class="col-sm-3">Final Price</dt>
    <dd class="col-sm-9">@Model.FinalPrice.ToString("N0")</dd>
</dl>

@if (Model.Status == CourseStatus.Draft)
{
    <form asp-action="Publish"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">

        @Html.AntiForgeryToken()

        <button class="btn btn-success">
            Publish
        </button>
    </form>
}

@if (Model.Status == CourseStatus.Published)
{
    <form asp-action="Close"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">

        @Html.AntiForgeryToken()

        <button class="btn btn-secondary">
            Close
        </button>
    </form>
}

<hr />

<div class="d-flex justify-content-between mb-3">
    <h3>Lessons</h3>

    <a asp-action="CreateLesson"
       asp-route-courseId="@Model.Id"
       class="btn btn-primary">
        Add Lesson
    </a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Order</th>
            <th>Title</th>
            <th>Duration</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var lesson in Model.Lessons)
        {
            <tr>
                <td>@lesson.Order</td>
                <td>@lesson.Title</td>
                <td>@lesson.DurationMinutes min</td>

                <td>
                    <a asp-action="EditLesson"
                       asp-route-id="@lesson.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <form asp-action="DeleteLesson"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@lesson.Id" />

                        <input type="hidden"
                               name="courseId"
                               value="@Model.Id" />

                        <button class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>